{
  "name": "tsumu-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Account-free remote MCP bridge for Tsumu",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "node scripts/check-syntax.mjs && node scripts/generate-skills.mjs --check && node scripts/check-distribution.mjs && node scripts/check-claude-directory.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run generate:skills && wrangler deploy --dry-run",
    "deploy": "npm run generate:skills && wrangler deploy",
    "smoke": "node tests/smoke.mjs",
    "generate:skills": "node scripts/generate-skills.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "wrangler": "4.162.0",
    "ws": "8.23.0"
  }
}
